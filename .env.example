# ShadowPurge Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# SEARCH ENGINE API KEYS
# =============================================================================

# SerpAPI - 100 free searches/month at serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Google Custom Search Engine - 100 free queries/day
# Create at: https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=your_google_cse_key_here
GOOGLE_CSE_CX=your_google_cse_cx_here

# Bing Web Search API - 1000 free/month at Azure Marketplace
BING_API_KEY=your_bing_api_key_here

# =============================================================================
# SEARCH ENGINE SETTINGS
# =============================================================================

# Comma-separated list of engines to use: duckduckgo,serpapi,google,bing
SHADOWPURGE_SEARCH_ENGINES=duckduckgo,serpapi

# Maximum pages per search engine (1-10)
SHADOWPURGE_SEARCH_MAX_PAGES=3

# Maximum total results across all engines (1-1000)
SHADOWPURGE_SEARCH_MAX_RESULTS=100

# Request timeout in seconds
SHADOWPURGE_SEARCH_TIMEOUT=30

# Engine-specific API keys (can also be set via individual vars above)
SHADOWPURGE_SEARCH_SERPAPI__API_KEY=
SHADOWPURGE_SEARCH_GOOGLE_CSE__API_KEY=
SHADOWPURGE_SEARCH_GOOGLE_CSE__CX=
SHADOWPURGE_SEARCH_BING__API_KEY=

# =============================================================================
# DELETION AUTOMATION SETTINGS
# =============================================================================

# Browser to use: chromium, firefox, webkit
SHADOWPURGE_DELETION_BROWSER=chromium

# Run browser in headless mode (true/false)
SHADOWPURGE_DELETION_HEADLESS=false

# Timeout in milliseconds (default: 60000 = 60 seconds)
SHADOWPURGE_DELETION_TIMEOUT=60000

# Slow down operations by N milliseconds (useful for debugging)
SHADOWPURGE_DELETION_SLOW_MO=0

# Browser user data directory for session persistence (optional)
# SHADOWPURGE_DELETION_USER_DATA_DIR=./browser_data

# Browser viewport size
SHADOWPURGE_DELETION_VIEWPORT_WIDTH=1280
SHADOWPURGE_DELETION_VIEWPORT_HEIGHT=720

# =============================================================================
# OUTPUT & EXPORT SETTINGS
# =============================================================================

# Default export format: json, csv, html, markdown
SHADOWPURGE_OUTPUT_FORMAT=json

# Export directory
SHADOWPURGE_OUTPUT_EXPORT_DIR=./exports

# Include timestamps in exports
SHADOWPURGE_OUTPUT_INCLUDE_TIMESTAMPS=true

# Include search snippets in exports
SHADOWPURGE_OUTPUT_INCLUDE_SNIPPETS=true

# =============================================================================
# SCANNING SETTINGS
# =============================================================================

# Maximum concurrent requests (1-50)
SHADOWPURGE_SCAN_MAX_CONCURRENT=10

# Request timeout in seconds
SHADOWPURGE_SCAN_TIMEOUT=30

# Default user agent
SHADOWPURGE_SCAN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Follow HTTP redirects
SHADOWPURGE_SCAN_FOLLOW_REDIRECTS=true

# Verify SSL certificates
SHADOWPURGE_SCAN_VERIFY_SSL=true

# =============================================================================
# LOGGING SETTINGS
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
SHADOWPURGE_LOG_LEVEL=INFO

# Log format: json or text
SHADOWPURGE_LOG_FORMAT=text

# Log file path (optional)
# SHADOWPURGE_LOG_FILE=./logs/shadowpurge.log

# Log to console
SHADOWPURGE_LOG_CONSOLE=true

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Debug mode
SHADOWPURGE_DEBUG=false

# Data directory
SHADOWPURGE_DATA_DIR=./data

# Export directory
SHADOWPURGE_OUTPUT_EXPORT_DIR=./exports

# Cache directory
SHADOWPURGE_CACHE_DIR=./cache